[TEMPLATE]
# Events are read live from a Baserow database. The defaults below match the
# configured database, so no setup is required — override only if you use a
# different database. NOTE: the token is sent from the browser, so it is
# visible to visitors; keep it scoped to read-only in Baserow.
VITE_BASEROW_TOKEN=5QizEuQqqha4ViUdweWNCVuCo9S36RQx
VITE_BASEROW_EVENTS_TABLE_ID=1123078
VITE_BASEROW_CONTACTS_TABLE_ID=1123079

# Optional: how often (in ms) the Events page re-checks Baserow for changes.
# Defaults to 15000 (every 15 seconds); it also refreshes instantly whenever
# the tab regains focus/visibility. Set to 0 to disable auto-refresh.
VITE_EVENTS_REFRESH_MS=15000
