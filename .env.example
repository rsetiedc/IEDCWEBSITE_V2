[TEMPLATE]
VITE_BASEROW_API_URL=https://api.baserow.io/api
VITE_BASEROW_TOKEN=your_baserow_database_token_here
VITE_BASEROW_TABLE_ID=your_table_id_here

# Optional: how often (in ms) the Events page re-checks Baserow for changes.
# Defaults to 60000 (every minute). Set to 0 to disable auto-refresh.
VITE_EVENTS_REFRESH_MS=60000
